{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Visualia Worker",
  "version": "0.2.0",
  "identifier": "space.visualia.worker",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Visualia Worker",
        "width": 460,
        "height": 760,
        "minWidth": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  },
  "mainBinaryName": "visualia-worker-app"
}
