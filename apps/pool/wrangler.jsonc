{
  // The class pool (plans/pool.md): the pool page and one Pool Durable Object
  // per school. Workers (browser tabs) connect out to it by WebSocket; the
  // gateway reaches it only through a service binding (entrypoint ForGateway).
  "name": "visualia-pool",
  "main": "src/index.js",
  "workers_dev": false,
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "pool.visualia.space", "custom_domain": true }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "POOL", "class_name": "Pool" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Pool"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "visualia", "database_id": "3a83dd5a-c118-4d17-bbcc-7e07a635774c", "migrations_dir": "../gateway/migrations" }
  ],
  "vars": { "HOST": "pool.visualia.space" },
  // secret: SESSION_SECRET (signs the pool page's sign-in cookie)
  "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }],
  "observability": { "enabled": true }
}
