{
  "name": "visualia-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "visualia-ledger",
      "database_id": "9ff50b2b-e7c3-4873-9f08-abd46b49eead",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AI_GATEWAY_ID": "visualia",
    "DEFAULT_MODEL": "@cf/qwen/qwen3.8-27b"
  },
  "observability": { "enabled": true }
}
