      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AI_GATEWAY_ID": "visualia",
    "DEFAULT_MODEL": "@cf/qwen/qwen3.8-27b"
  },
  "observability": { "enabled": true }
}
