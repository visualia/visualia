{
  "name": "visualia-gateway",
  "main": "src/index.js",
  "workers_dev": false,
  "compatibility_date": "2026-10-01",
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "visualia",
      "database_id": "3a83dd5a-c118-4d17-bbcc-7e07a635774c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AI_GATEWAY_ID": "visualia",
    "DEFAULT_MODEL": "@cf/deepseek-ai/deepseek-v4.1-flash-1017",
    "M1_URL": "https://m1-1.visualia.space"
  },
  "routes": [{ "pattern": "gw.visualia.space", "custom_domain": true }],
  // The class pool (apps/pool): jobs for `pool/<model>` go to its Pool Durable Object.
  "services": [{ "binding": "POOL", "service": "visualia-pool", "entrypoint": "ForGateway" }],
  "ratelimits": [{ "name": "KEY_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }],
  "observability": { "enabled": true }
}
