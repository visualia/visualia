{
  "name": "visualia-studio",
  "main": "src/index.js",
  "workers_dev": false,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "visualia.space", "custom_domain": true },
    { "pattern": "studio.visualia.space", "custom_domain": true },
    { "pattern": "projects.visualia.space", "custom_domain": true },
    { "pattern": "preview.visualia.space", "custom_domain": true }
  ],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "rules": [{ "type": "Text", "globs": ["**/*.md"] }],
  "durable_objects": { "bindings": [{ "name": "StudioAgent", "class_name": "StudioAgent" }, { "name": "Class", "class_name": "Class" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StudioAgent"] }, { "tag": "v2", "new_sqlite_classes": ["Class"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "visualia", "database_id": "3a83dd5a-c118-4d17-bbcc-7e07a635774c", "migrations_dir": "../gateway/migrations" }
  ],
  "r2_buckets": [{ "binding": "PROJECTS", "bucket_name": "visualia-projects" }],
  "browser": { "binding": "BROWSER" },
  "images": { "binding": "IMAGES" },
  "services": [{ "binding": "GATEWAY", "service": "visualia-gateway", "entrypoint": "Trusted" }],
  "vars": { "STUDIO_HOSTS": "visualia.space studio.visualia.space", "PROJECTS_HOST": "projects.visualia.space", "PREVIEW_HOST": "preview.visualia.space", "PAGE_MODEL": "@cf/deepseek-ai/deepseek-v4.1-flash-1017" },
  "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "observability": { "enabled": true }
}
